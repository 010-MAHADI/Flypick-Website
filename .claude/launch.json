{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "customer-site",
      "cwd": "client/Customer_site",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "seller-side",
      "cwd": "client/seller-side",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 8081
    },
    {
      "name": "backend",
      "cwd": "server",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-Command",
        "$env:USE_SQLITE='True'; $env:PYTHONIOENCODING='utf-8'; ./venv/Scripts/python.exe manage.py runserver 8000"
      ],
      "port": 8000
    }
  ]
}
